# Optional. Server-side fal key (key_id:key_secret). Visitors can still paste their
# own key; without accounts and credits, a public deployment with FAL_KEY set lets
# anyone spend on it, so only set it on private deployments for now.
FAL_KEY=
# Optional. Defaults to https://queue.fal.run.
FAL_QUEUE_URL=
# Vercel Blob read-write token, for media uploads.
OPEN_HIGGSFIELD_READ_WRITE_TOKEN=
